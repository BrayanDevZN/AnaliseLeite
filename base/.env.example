# Copie para .env (na raiz de base/) e preencha. O .env nao vai para o git.
# Quem le este arquivo: o backend em Go (go run .), o pipeline em Python e o docker compose.

# --- obrigatorias ---
# chave que assina os tokens do backend (minimo de 32 caracteres)
JWT_SECRET=
# chave de API do pipeline (o backend manda ela em cada chamada)
ML_KEY=

# --- agente de imagem (pipeline, rota POST /model/image) ---
# modelo de visao por uma API compativel com a OpenAI. Os tres precisam existir para o pipeline subir.
# Groq:      BASE_URL=https://api.groq.com/openai/v1   MODEL=qwen/qwen3.8-27b
# LM Studio: BASE_URL=http://127.0.0.1:1234/v1          MODEL=qwen2.5-vl-3b-instruct   (API_KEY = token do LM Studio)
# Dentro do docker, 127.0.0.1 e o proprio container: para um servidor na sua maquina use a URL que o container alcance.
BASE_URL=
API_KEY=
MODEL=

# --- backend ---
PORT=8080
# URL do pipeline para rodar o backend FORA do docker; no compose ela vira http://pipeline:7000
MODEL_URL=http://localhost:7000
# banco de dados; sem ela, SQLite em data/data.db. No compose ela vira sqlite:///data/app.db
# DATABASE_URL=
# sem REDIS_URL nao ha cache e o rate limit conta na memoria
# REDIS_URL=redis://localhost:6379/0

# true tira o Secure dos cookies: so para desenvolvimento local em http
COOKIE_INSECURE=true
# COOKIE_DOMAIN=
# lax (padrao), strict ou none. Use none so se o site e o backend ficam em sites diferentes (ex.: dois subdominios de up.railway.app); precisa de https
# COOKIE_SAMESITE=lax
# origens do frontend que podem chamar a API (com cookies), separadas por virgula. Sem ela, o CORS fica desligado
CORS_ORIGINS=http://localhost:5173
# true so se o backend estiver atras de um proxy confiavel
# TRUST_PROXY=false

# cria este admin na primeira vez que o backend sobe
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_NAME=Admin

# --- login com o Google (opcional: sem as tres primeiras, as rotas /auth/google respondem 503) ---
# crie um "OAuth client ID" do tipo Web em console.cloud.google.com e cadastre la o GOOGLE_REDIRECT_URL
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URL=http://localhost:8080/auth/google/callback
# para onde o navegador vai depois de entrar (padrao "/") e se der erro (com ?error=<motivo>; padrao = o de sucesso)
# GOOGLE_SUCCESS_URL=/
# GOOGLE_FAILURE_URL=/

# --- interface (frontend) no docker ---
# endereco do backend como o NAVEGADOR enxerga; fica gravado no JavaScript, entao mudar exige refazer a imagem
# VITE_API_URL=http://localhost:8080
# Para o site e o backend em dominios diferentes (ex.: dois servicos do Railway): use VITE_API_URL=/api e defina BACKEND_URL
# no servico da interface. O nginx do site repassa /api/... ao backend, o navegador ve um site so e os cookies funcionam.
# BACKEND_URL=https://seu-backend.exemplo.com   (padrao no compose: http://backend:8080)
# porta do site no seu computador. Ela precisa estar no CORS_ORIGINS (ex.: http://localhost:5173)
# INTERFACE_PORT=5173
